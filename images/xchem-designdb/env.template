# =========================================================
# DATABASE CONFIGURATION
# =========================================================
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=trust
PGDATA=/var/lib/postgresql/data
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# Volume path for persistent data
POSTGRES_DATA_PATH=CHANGE_ME

# Build versions (RDKit / Postgres versions)
RDKIT_VERSION=Release_2025_09_5
BOOST_VERSION=1.90.0
BOOST_VER_US=1_90_0
# DEBIAN_SUITE must match the suffix in PG_BASE (e.g. postgres:18.4-trixie)
DEBIAN_SUITE=trixie
PG_MAJOR=18
PG_BASE=postgres:18.4-trixie
# Gosu CVE fix: rebuild gosu with patched Go stdlib (remove when postgres image fixes upstream)
GOLANG_VERSION=1.26.5-alpine
GOSU_VERSION=1.19
# golang.org/x/sys bump for CVE-2026-39824 in gosu binary
GOLANG_X_SYS_VERSION=0.44.0
